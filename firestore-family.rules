// 家庭空間的 Firestore 規則
// 用法：Firebase 主控台 → Firestore Database → 規則，
// 把下面這一段貼進 match /databases/{database}/documents { … } 的大括號裡（原本的規則都保留），再按「發布」。

    function famEmail() { return request.auth.token.email.lower(); }
    function famSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    // families/{id}：成員名單（members 是小寫 Email）。成員可以看；只有建立的人能改名單、刪除
    match /families/{fid} {
      allow read: if famSignedIn() && famEmail() in resource.data.members;
      allow create: if famSignedIn() && request.resource.data.owner == request.auth.uid
                    && famEmail() in request.resource.data.members;
      allow update: if famSignedIn() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.ownerEmail == resource.data.ownerEmail;
      allow delete: if famSignedIn() && resource.data.owner == request.auth.uid;

      // 共用資料（例如櫃子）：所有成員都能讀寫
      match /data/{doc} {
        allow read, write: if famSignedIn()
          && famEmail() in get(/databases/$(database)/documents/families/$(fid)).data.members;
      }
    }
